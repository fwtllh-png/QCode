{
  "protocol": "openai_chat",
  "path": "/chat/completions",
  "model": "fixture-model",
  "stream_delay_ms": 40,
  "routes": [
    {
      "match": ["Name a coding conversation from the user's first request."],
      "streams": ["session-title.sse"]
    },
    {
      "match": ["visual host command"],
      "streams": ["host-command.sse", "approval-complete.sse"]
    },
    {
      "match": ["visual session title"],
      "streams": ["tools-read.sse", "tools-complete.sse", "tools-complete.sse"]
    },
    {
      "match": ["visual commentary"],
      "streams": ["commentary-read.sse", "commentary-search.sse", "tools-complete.sse"]
    },
    {
      "match": ["visual plan"],
      "streams": ["plan-layout.sse"]
    },
    {
      "match": ["visual navigation"],
      "streams": [
        "tools-read.sse",
        "tools-bash.sse",
        "tools-grep.sse",
        "tools-glob.sse",
        "tools-complete.sse",
        "chrome-complete.sse",
        "chrome-complete.sse",
        "chrome-complete.sse"
      ]
    },
    {
      "match": ["visual queue"],
      "streams": [
        "long-streaming.sse",
        "streaming-complete.sse"
      ]
    },
    {
      "match": ["visual long streaming"],
      "streams": ["long-streaming.sse", "streaming-complete.sse"]
    },
    {
      "match": ["visual streaming"],
      "streams": ["streaming.sse", "streaming-complete.sse"]
    },
    {
      "match": ["visual approval"],
      "streams": [
        "plan-submit.sse",
        "approval-request.sse",
        "approval-complete.sse"
      ]
    },
    {
      "match": ["visual background approval"],
      "streams": [
        "plan-submit.sse",
        "background-approval.sse",
        "background-verify.sse",
        "approval-complete.sse"
      ]
    },
    {
      "match": ["visual edit approval"],
      "streams": [
        "diff-read.sse",
        "plan-submit.sse",
        "edit-request.sse",
        "approval-request.sse",
        "edit-verify.sse",
        "edit-complete.sse"
      ]
    },
    {
      "match": ["visual input"],
      "streams": ["input-request.sse", "input-answer.sse", "input-complete.sse"]
    },
    {
      "match": ["visual failure"],
      "streams": ["failure.sse"]
    },
    {
      "match": ["visual tools"],
      "streams": [
        "tools-read.sse",
        "tools-bash.sse",
        "tools-grep.sse",
        "tools-glob.sse",
        "tools-complete.sse"
      ]
    },
    {
      "match": ["visual chrome"],
      "streams": ["chrome-summary.sse", "chrome-complete.sse"]
    },
    {
      "match": ["visual rich content"],
      "streams": ["rich-content-complete.sse"]
    },
    {
      "match": ["visual diff"],
      "streams": [
        "diff-read.sse",
        "diff-edit.sse",
        "diff-verify.sse",
        "diff-complete.sse"
      ]
    }
  ]
}
