    {
      "path": "internal/platform/repowalk/repowalk.go",
      "categories": [
        "process"
      ],
      "owner": "repository walker",
      "reason": "Runtime-owned sandboxed read-only Git file enumeration."
    },
    {
      "path": "internal/runtime/app/workspacequery/git.go",
      "categories": [
        "process"
      ],
      "owner": "workspace query",
      "reason": "Application-owned fixed read-only Git metadata queries; Git mutations belong to Runtime GitControl and guarded tools."
    },
    {
      "path": "internal/runtime/app/workspacequery/git_inspect.go",
      "categories": [
        "process"
      ],
      "owner": "workspace query",
