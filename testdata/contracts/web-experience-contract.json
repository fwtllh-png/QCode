{
  "version": 1,
  "stylesheets": [
    "web/src/ui/styles.css",
    "web/src/ui/SettingsDialog.css",
    "web/src/ui/WorkspaceContextDialog.css",
    "web/src/ui/Trajectory.css",
    "web/src/ui/theme/tokens.css",
    "web/src/ui/theme/components.css",
    "web/src/ui/primitives/primitives.css",
    "web/src/ui/GitTools.css"
  ],
  "layout_regions": [
    "session_rail",
    "conversation",
    "composer",
    "settings_dialog",
    "context_dialog",
    "trajectory_inspector",
    "git_tools"
  ],
  "responsive_tracks": [
    {
      "mode": "compact",
      "min_width": 320,
      "max_width": 720,
      "tracks": "minmax(0, 1fr)",
      "yield_order": [
        "session_rail"
      ]
    },
    {
      "mode": "regular",
      "min_width": 721,
      "max_width": 1240,
      "tracks": "280px minmax(0, 1fr)",
      "yield_order": []
    },
    {
      "mode": "wide",
      "min_width": 1241,
      "max_width": 3840,
      "tracks": "280px minmax(0, 1fr)",
      "yield_order": []
    }
  ],
  "semantic_tokens": [
    "--ch-canvas",
    "--ch-panel",
    "--ch-panel-subtle",
    "--ch-panel-raised",
    "--ch-sidebar",
    "--ch-border",
    "--ch-border-strong",
    "--ch-text",
    "--ch-text-secondary",
    "--ch-text-muted",
    "--ch-text-caption",
    "--ch-accent",
    "--ch-accent-hover",
    "--ch-accent-soft",
    "--ch-business",
    "--ch-business-soft",
    "--ch-reasoning",
    "--ch-tool",
    "--ch-on-accent",
    "--ch-danger",
    "--ch-danger-soft",
    "--ch-warning",
    "--ch-success",
    "--ch-focus",
    "--ch-code",
    "--ch-shadow",
    "--ch-modal-mask",
    "--ch-modal-shadow",
    "--ch-composer-shadow",
    "--ch-rail-width",
    "--ch-rail-collapsed-width",
    "--ch-chat-width",
    "--ch-composer-width",
    "--ch-header-height",
    "--ch-radius",
    "--ch-radius-panel",
    "--ch-radius-modal",
    "--ch-radius-conversation",
    "--ch-motion-none",
    "--ch-motion-spin",
    "--ch-motion-panel",
    "--ch-motion-disclosure",
    "--ch-motion-enter",
    "--ch-motion-exit",
    "--ch-motion-skeleton",
    "--ch-motion-feedback",
    "--ch-radius-control",
    "--ch-success-soft",
    "--ch-warning-soft",
    "--ch-inspector-width",
    "--ch-motion-pending",
    "--ch-ease-in-out",
    "--ch-ease-enter",
    "--ch-ease-exit",
    "--ch-layer-behind",
    "--ch-layer-content",
    "--ch-layer-composer",
    "--ch-layer-overlay",
    "--ch-layer-popover",
    "--ch-layer-timeline-range",
    "--ch-layer-timeline-span",
    "--ch-layer-timeline-control",
    "--ch-trajectory-row-height",
    "--ch-trajectory-span-min"
  ],
  "canonical_states": [
    "empty",
    "blank_session",
    "streaming",
    "tool_collapsed",
    "tool_expanded",
    "approval",
    "input",
    "failure",
    "completed",
    "diff",
    "settings",
    "settings_models",
    "settings_tools",
    "settings_agent",
    "context_browser",
    "edit_approval",
    "trajectory"
  ],
  "motion": [
    {
      "id": "working_spinner",
      "selector": ".spin",
      "full": "infinite_rotation",
      "reduced": "single_frame",
      "still": "static_icon"
    },
    {
      "id": "working_text",
      "selector": ".turnStatus",
      "full": "static_text",
      "reduced": "single_frame",
      "still": "static_text"
    },
    {
      "id": "tool_running",
      "selector": ".toolDisclosure[data-running]",
      "full": "tonal_state",
      "reduced": "single_frame",
      "still": "status_text"
    },
    {
      "id": "pending_interaction",
      "selector": ".approvalDot",
      "full": "pending_pulse_1200ms",
      "reduced": "single_frame",
      "still": "status_text"
    },
    {
      "id": "disclosure",
      "selector": ".uiCollapse",
      "full": "grid_expand_220ms_unmount_after_exit",
      "reduced": "immediate",
      "still": "expanded_or_hidden"
    },
    {
      "id": "git_tools",
      "selector": ".gitTools",
      "full": "slide_fade_enter_240ms_exit_180ms",
      "reduced": "immediate",
      "still": "visible_or_hidden"
    },
    {
      "id": "overlay_presence",
      "selector": ".uiPresence",
      "full": "interruptible_enter_exit_with_inert_retained_content",
      "reduced": "immediate_unmount",
      "still": "visible_or_hidden"
    },
    {
      "id": "loading_skeleton",
      "selector": ".uiSkeleton",
      "full": "opacity_pulse_1600ms",
      "reduced": "static",
      "still": "static"
    }
  ],
  "focus_order": [
    "new_chat",
    "session_search",
    "session_list",
    "conversation_actions",
    "transcript",
    "current_interaction",
    "composer",
    "modal_dialog"
  ],
  "keyboard_commands": [
    {
      "id": "submit",
      "key": "Enter",
      "accessible_name": "Send"
    },
    {
      "id": "newline",
      "key": "Shift+Enter",
      "accessible_name": "Prompt"
    },
    {
      "id": "close_overlay",
      "key": "Escape",
      "accessible_name": "Close"
    }
  ],
  "stable_geometry": [
    ".conversationHeader",
    ".sessionRow",
    ".composerSeat",
    ".composer",
    ".contextMeter",
    ".pendingComposer",
    ".settingsDialog",
    ".contextDialog",
    ".iconButton",
    ".trajectoryTimeline",
    ".ledgerRow",
    ".recordInspector",
    ".trajectoryMetrics",
    ".gitTools"
  ],
  "behavior": {
    "transcript_auto_follow": "only_when_near_bottom",
    "history_prepend_anchor": "preserve_visible_turn",
    "approval_takeover": "replace_composer_without_resizing_shell",
    "input_takeover": "replace_composer_without_resizing_shell",
    "context_open": "modal_without_resizing_shell",
    "trajectory_inspector": "view_local_resizable_panel"
  },
  "viewports": [
    "390x844",
    "1024x768",
    "1440x900",
    "1920x1080"
  ],
  "themes": [
    "light",
    "dark",
    "forced-colors"
  ],
  "zoom_percent": [
    100,
    200
  ],
  "golden_directory": "web/tests/e2e/visual.spec.ts-snapshots",
  "goldens": [
    "canonical-approval.png",
    "canonical-back-to-bottom.png",
    "canonical-blank-session.png",
    "canonical-completed.png",
    "canonical-diff.png",
    "canonical-edit-approval.png",
    "canonical-edit-completed.png",
    "canonical-empty.png",
    "canonical-failure.png",
    "canonical-input.png",
    "canonical-settings.png",
    "canonical-settings-models.png",
    "canonical-settings-tools.png",
    "canonical-settings-agent.png",
    "canonical-context-browser.png",
    "canonical-streaming.png",
    "canonical-tool-collapsed.png",
    "canonical-tool-expanded.png",
    "canonical-trajectory.png",
    "canonical-trajectory-detail.png",
    "viewport-390x844-dark.png",
    "viewport-390x844-light.png",
    "viewport-1024x768-dark.png",
    "viewport-1024x768-forced-colors.png",
    "viewport-1024x768-light.png",
    "viewport-1024x768-zoom-200.png",
    "viewport-1440x900-dark.png",
    "viewport-1440x900-light.png",
    "viewport-1920x1080-dark.png",
    "viewport-1920x1080-light.png"
  ],
  "css_policy": {
    "semantic_prefix": "--ch-",
    "max_card_radius_px": 24,
    "forbid_transition_all": true,
    "require_reduced_motion_for_infinite": true,
    "require_registered_z_index": true
  }
}
