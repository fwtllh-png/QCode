{
  "version": 1,
  "journey": [
    {
      "id": "start",
      "runtime_events": ["turn.started"],
      "required_feedback": ["current Chat", "active Turn", "stop action"]
    },
    {
      "id": "stream",
      "runtime_events": ["output.delta", "reasoning.delta", "tool.start", "tool.output", "tool.result"],
      "required_feedback": ["incremental output", "progressive detail", "visible working state"]
    },
    {
      "id": "approve",
      "runtime_events": ["approval.required", "approval.resolved"],
      "required_feedback": ["target and effect", "Runtime identity", "approve", "deny", "cancel"]
    },
    {
      "id": "input",
      "runtime_events": ["input.required", "input.resolved"],
      "required_feedback": ["prompt", "available choices", "keyboard response"]
    },
    {
      "id": "cancel",
      "runtime_events": ["turn.canceled"],
      "required_feedback": ["terminal state", "reason", "next action"]
    },
    {
      "id": "verify",
      "runtime_events": ["diagnostics.result", "turn.verification"],
      "required_feedback": ["command or scope", "verdict", "failure detail"]
    },
    {
      "id": "recover",
      "runtime_events": ["turn.started", "turn.completed", "turn.failed", "turn.canceled"],
      "required_feedback": ["restored Chat", "cursor continuity", "recovery state"]
    },
    {
      "id": "receipt",
      "runtime_events": ["turn.receipt"],
      "required_feedback": ["changes", "verification", "usage", "unresolved issues"]
    }
  ],
  "hosts": {
    "web": {
      "transport": "localhost HTTP and WebSocket",
      "evidence": [
        "internal/host/intergration_test/scenarios_test.go",
        "internal/host/intergration_test/web_test.go",
        "internal/host/server_test.go",
        "internal/host/launcher_test.go",
        "web/src/runtime/client.test.ts"
      ]
    }
  },
  "invariants": [
    "each Turn reaches exactly one terminal event",
    "resume from a persisted cursor has no gap or duplicate",
    "approval decisions remain bound to request, Turn, item, and Edit Plan identities",
    "verified completion is distinguishable from model output",
    "failure and recovery preserve a visible next action"
  ]
}
